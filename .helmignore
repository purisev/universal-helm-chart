# Patterns to ignore when building packages with Helm.
# Supports shell glob matching, relative path matching, and negation (prefixed with !).
# One pattern per line.

# Development tooling
CLAUDE.md
.claude/

# CI / test fixtures / repo workflows — not part of the chart artifact
ci/
tests/
test/
.github/

# Documentation, examples, ADRs — never shipped in the OCI artifact
docs/

# mdBook (docs/ -> GitHub Pages) — config and build output, not chart content
book.toml
book/

# OS artifacts
.DS_Store

# Git
.git
.gitignore
.gitattributes
