# values.yaml.example — every chart feature exercised in one file.
# Passes `helm template`; do NOT deploy verbatim.
# Copy relevant sections into your real values file.

# ---------------------------------------------------------------------------
# Global env (subchart "global:" mechanism — propagates to all subcharts)
# ---------------------------------------------------------------------------
global:
  env:
    CLUSTER_NAME:
      value: prod-us-east-1

# ---------------------------------------------------------------------------
# Release-level env — injected into every container
# ---------------------------------------------------------------------------
env:
  APP_ENV:
    value: production
  POD_NAMESPACE:
    fieldRef:
      fieldPath: metadata.namespace

commonLabels:
  cost-center: platform
  team: backend

commonAnnotations:
  owner: platform-team@example.com
  repo: https://github.com/example/myapp

# Standard label toggles (all on by default; shown explicitly for reference)
labels:
  standard:
    enabled: true
    name: true
    instance: true
    version: true
    managedBy: true
    partOf: true

# ---------------------------------------------------------------------------
# Integrations
# ---------------------------------------------------------------------------

integrations:

  argocd:
    syncWaves:
      enabled: true
      ingress: 40                         # push Ingress past a CRD wave at 35
      deployment: 20                      # keep default; shown for reference

    imageUpdater:
      enabled: true
      namespace: argocd
      appNamePattern: myapp
      commonUpdateSettings:
        updateStrategy: semver
        allowTags: "regexp:^v[0-9]+\\.[0-9]+\\.[0-9]+$"
      writeBackConfig:
        method: argocd
      images:
        api:
          imageName: ghcr.io/example/api
          manifestTargets:
            helm:
              name: deployments.api.image.repository
              tag: deployments.api.image.tag

  stakater:
    reloader:
      enabled: true                       # injects reloader.stakater.com/auto: "true"

  eso:
    enabled: true

    secretStores:
      vault:
        enabled: true
        kind: SecretStore
        provider:
          vault:
            server: https://vault.example.com
            path: secret
            version: v2
            auth:
              jwt:
                mountPath: jwt
                role: myapp-role
                audiences:
                  - vault
                expirationSeconds: 600

      aws-secrets-manager:
        enabled: true
        kind: SecretStore
        provider:
          aws:
            service: SecretsManager
            region: eu-west-1
            auth:
              jwt: {}

    externalSecrets:
      app-secrets:
        enabled: true
        secretStore: vault
        refreshInterval: 1h
        targetName: app-secrets
        data:
          DB_PASSWORD:
            remoteKey: myapp/db
            property: password
          API_TOKEN:
            remoteKey: myapp/api
            property: token

      worker-bulk:
        enabled: true
        secretStore: vault
        refreshInterval: 30m
        dataFrom:
          - remoteKey: myapp/worker
            conversionStrategy: Default
            decodingStrategy: None

  monitoring:
    defaults:
      enabled: true
      provider: prometheus               # use "victoriametrics" for VMServiceScrape/VMPodScrape
      discovery: crd                     # use "annotations" to inject prometheus.io/* instead
      type: service
      port: metrics
      path: /metrics
      scheme: http
      interval: 30s
      scrapeTimeout: 10s
      exposeService:
        enabled: true                    # auto-add metrics port to Services without one
        port: 9090
        targetPort: 9090

# ---------------------------------------------------------------------------
# Root image (inherited by workloads that do not override)
# ---------------------------------------------------------------------------
image:
  repository: ghcr.io/example/api
  tag: v1.2.3
  pullPolicy: IfNotPresent

imagePullSecrets:
  - regcred

# ---------------------------------------------------------------------------
# Default resource requests/limits (overridden per-workload below)
# ---------------------------------------------------------------------------
resources:
  requests:
    cpu: 50m
    memory: 64Mi
  limits:
    memory: 128Mi

# ---------------------------------------------------------------------------
# Deployment behaviour
# ---------------------------------------------------------------------------
revisionHistoryLimit: 5
progressDeadlineSeconds: 300

strategy:
  type: RollingUpdate
  rollingUpdate:
    maxSurge: 1
    maxUnavailable: 0

statefulSetUpdateStrategy:
  type: RollingUpdate
  rollingUpdate:
    partition: 0

minReadySeconds: 5

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
serviceAccount:
  create: true
  name: myapp
  annotations:
    eks.amazonaws.com/role-arn: arn:aws:iam::123456789012:role/myapp-role
  automountServiceAccountToken: false    # object-level default; pods can still override below

rbac:
  enabled: true
  clusterScoped: true                    # ClusterRole + ClusterRoleBinding (false renders Role + RoleBinding)
  rules:
    - apiGroups: [""]
      resources: ["configmaps"]
      verbs: ["get", "list", "watch"]
    - apiGroups: ["coordination.k8s.io"]
      resources: ["leases"]
      verbs: ["get", "create", "update"]
  # aggregationRule only applies to ClusterRole. Once set, Kubernetes' own
  # ClusterRole controller overwrites .rules on every reconcile with the
  # union of every ClusterRole matching the selector below — the rules
  # hardcoded above do NOT keep applying alongside it and will be replaced.
  # Combine static rules with aggregation only via a separate ClusterRole
  # (one static, one aggregating) if you need both.
  aggregationRule:
    clusterRoleSelectors:
      - matchLabels:
          rbac.myapp.example.com/aggregate-to-myapp: "true"

# Pod-level default; distinct from serviceAccount.automountServiceAccountToken above
# (this one can be overridden per-workload, that one is the ServiceAccount object's own default)
automountServiceAccountToken: false

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------
podSecurityContext:
  runAsNonRoot: true
  runAsUser: 1000
  runAsGroup: 1000
  fsGroup: 1000
  seccompProfile:
    type: RuntimeDefault

securityContext:
  allowPrivilegeEscalation: false
  readOnlyRootFilesystem: true
  capabilities:
    drop:
      - ALL

# ---------------------------------------------------------------------------
# Annotations injected into every pod template
# ---------------------------------------------------------------------------
podAnnotations:
  cluster-autoscaler.kubernetes.io/safe-to-evict: "true"

# Annotations injected into every Job/CronJob pod template
jobPodAnnotations:
  sidecar.istio.io/inject: "false"

# ---------------------------------------------------------------------------
# Pod-level settings
# ---------------------------------------------------------------------------
terminationGracePeriodSeconds: 60

hostAliases:
  - ip: "192.168.100.10"
    hostnames:
      - "internal-registry.local"

priorityClassName: high-priority

# ---------------------------------------------------------------------------
# Scheduling (inherited by all workloads; override per-workload to replace)
# ---------------------------------------------------------------------------
nodeSelector:
  kubernetes.io/os: linux

tolerations:
  - key: dedicated
    operator: Equal
    value: app
    effect: NoSchedule

affinity:
  podAntiAffinity:
    preferredDuringSchedulingIgnoredDuringExecution:
      - weight: 100
        podAffinityTerm:
          labelSelector:
            matchLabels:
              app.kubernetes.io/name: api
          topologyKey: kubernetes.io/hostname

topologySpreadConstraints:
  - maxSkew: 1
    topologyKey: topology.kubernetes.io/zone
    whenUnsatisfiable: ScheduleAnyway

# ---------------------------------------------------------------------------
# Root volumes and mounts (available to all workloads unless opted out)
# ---------------------------------------------------------------------------
volumes:
  shared-tmp:
    emptyDir: {}

# volumeMounts keyed by workload name → applied to that container
volumeMounts:
  api:
    shared-tmp:
      mountPath: /tmp

# ---------------------------------------------------------------------------
# Root envSecrets / envConfigMaps (injected via envFrom into every container)
# ---------------------------------------------------------------------------
envSecrets:
  - app-secrets

envConfigMaps:
  - app-config

# ---------------------------------------------------------------------------
# ConfigMaps (chart-owned; auto-mounted when mountPath is set)
# ---------------------------------------------------------------------------
configMaps:
  app-config:
    enabled: true
    mountPath: /etc/app
    data:
      config.yaml: |
        log_level: info
        db_host: db.default.svc.cluster.local

  feature-flags:
    enabled: true
    mountPath: /etc/feature-flags
    data:
      flags.yaml: |
        new-checkout: true

# ---------------------------------------------------------------------------
# Cluster-wide PodDisruptionBudget (applied to all workloads unless overridden)
# ---------------------------------------------------------------------------
podDisruptionBudget:
  enabled: true
  minAvailable: 1
  unhealthyPodEvictionPolicy: AlwaysAllow  # let already-unhealthy pods be evicted during node drains

# Disabled at root; opted in per-workload below
verticalPodAutoscaler:
  enabled: false
  updateMode: Initial

# ---------------------------------------------------------------------------
# Completion image used by jobGroups tasks mode
# ---------------------------------------------------------------------------
jobCompletionImage: alpine:3.21

# ---------------------------------------------------------------------------
# Networking — Ingress
# ---------------------------------------------------------------------------

# Singleton Ingress
ingress:
  enabled: true
  ingressClassName: nginx
  annotations:
    cert-manager.io/cluster-issuer: letsencrypt-prod
    nginx.ingress.kubernetes.io/proxy-read-timeout: "300"
  hosts:
    app.example.com:
      paths:
        - path: /
          pathType: Prefix
          servicePort: 80
  tls:
    - secretName: app-example-tls
      hosts:
        - app.example.com
  defaultBackend:
    serviceName: fallback-service
    servicePort: 8080

# Multiple named Ingresses
ingresses:
  internal:
    enabled: true
    ingressClassName: nginx-internal
    hosts:
      app.internal.example.com:
        paths:
          - path: /
            pathType: Prefix
            servicePort: 80

  admin:
    enabled: true
    ingressClassName: nginx-internal
    hosts:
      admin.internal.example.com:
        paths:
          - path: /
            pathType: Prefix
            servicePort: 8081

# ---------------------------------------------------------------------------
# Networking — Gateway API
# ---------------------------------------------------------------------------

# Singleton HTTPRoute (per-workload httpRoute.rules merge into this)
httpRoute:
  enabled: true
  parentRefs:
    - name: external-gateway
      namespace: gateway-system
      sectionName: https
  hostnames:
    - app.example.com

# Additional named HTTPRoutes
httpRoutes:
  admin:
    enabled: true
    parentRefs:
      - name: internal-gateway
        namespace: gateway-system
    hostnames:
      - admin.example.com
    rules:
      - backendRefs:
          - name: myapp-api
            port: 8081

  status:
    enabled: true
    parentRefs:
      - name: internal-gateway
        namespace: gateway-system
    hostnames:
      - status.example.com
    rules:
      - backendRefs:
          - name: myapp-api
            port: 8082

# Singleton GRPCRoute
grpcRoute:
  enabled: true
  parentRefs:
    - name: external-gateway
      namespace: gateway-system
      sectionName: grpc
  hostnames:
    - grpc.example.com
  rules:
    - matches:
        - method:
            type: Exact
            service: com.example.ApiService
      backendRefs:
        - name: myapp-api
          port: 9000

# Additional named GRPCRoutes
grpcRoutes:
  worker:
    enabled: true
    parentRefs:
      - name: internal-gateway
        namespace: gateway-system
        sectionName: grpc
    hostnames:
      - worker-grpc.example.com
    rules:
      - matches:
          - method:
              type: Exact
              service: com.example.WorkerService
        backendRefs:
          - name: myapp-worker
            port: 9001

# Singleton TLSRoute
tlsRoute:
  enabled: true
  parentRefs:
    - name: external-gateway
      namespace: gateway-system
      sectionName: tls-passthrough
  hostnames:
    - secure.example.com
  rules:
    - backendRefs:
        - name: myapp-api
          port: 8443

# Additional named TLSRoutes
tlsRoutes:
  worker:
    enabled: true
    parentRefs:
      - name: internal-gateway
        namespace: gateway-system
        sectionName: tls-passthrough
    hostnames:
      - worker-secure.example.com
    rules:
      - backendRefs:
          - name: myapp-worker
            port: 8444

# Singleton ReferenceGrant
referenceGrant:
  enabled: true
  from:
    - group: gateway.networking.k8s.io
      kind: HTTPRoute
      namespace: gateway-system
  to:
    - group: ""
      kind: Service

# Additional named ReferenceGrants
referenceGrants:
  from-grpc-gw:
    enabled: true
    from:
      - group: gateway.networking.k8s.io
        kind: GRPCRoute
        namespace: gateway-system
    to:
      - group: ""
        kind: Service

  from-tls-gw:
    enabled: true
    from:
      - group: gateway.networking.k8s.io
        kind: TLSRoute
        namespace: gateway-system
    to:
      - group: ""
        kind: Service

# ---------------------------------------------------------------------------
# Deployments
# ---------------------------------------------------------------------------

deployments:

  # --- api: main HTTP API ---
  # Features: service ports, appProtocol, internalTrafficPolicy, HPA, VPA,
  #           PDB, sidecar, initContainer, probes, lifecycle, networkPolicy,
  #           httpRoute shorthand, ServiceMonitor (CRD)
  api:
    replicaCount: 2

    service:
      enabled: true
      type: ClusterIP
      internalTrafficPolicy: Local        # route in-cluster traffic only to same-node pods
      ports:
        http:
          port: 80
          targetPort: 8080
        grpc:
          port: 9000
          targetPort: 9000
          # Lets Gateway API implementations (e.g. GRPCRoute backends) know
          # this port speaks HTTP/2 cleartext, so they configure the
          # upstream as h2c instead of assuming HTTP/1.1.
          appProtocol: kubernetes.io/h2c
        admin:
          port: 8081
          targetPort: 8081
        metrics:
          port: 9090
          targetPort: 9090

    env:
      LOG_LEVEL:
        value: info
      POD_NAME:
        fieldRef:
          fieldPath: metadata.name

    envSecrets:
      - app-secrets

    metrics:
      enabled: true
      port: metrics
      path: /metrics

    probesEnabled: true
    readinessProbe:
      httpGet:
        path: /health/ready
        port: http
      initialDelaySeconds: 5
      periodSeconds: 10
      failureThreshold: 3
    livenessProbe:
      httpGet:
        path: /health/live
        port: http
      initialDelaySeconds: 15
      periodSeconds: 20
    startupProbe:
      httpGet:
        path: /health/ready
        port: http
      failureThreshold: 30
      periodSeconds: 5

    lifecycle:
      preStop:
        exec:
          command: ["/bin/sh", "-c", "sleep 10"]

    resources:
      requests:
        cpu: 200m
        memory: 256Mi
      limits:
        memory: 512Mi

    # HPA (mutually exclusive with keda on the same workload)
    hpa:
      enabled: true
      minReplicas: 2
      maxReplicas: 10
      metrics:
        - type: Resource
          resource:
            name: cpu
            target:
              type: Utilization
              averageUtilization: 70
        - type: Resource
          resource:
            name: memory
            target:
              type: Utilization
              averageUtilization: 80

    # VPA (compatible with HPA when targeting different axes)
    verticalPodAutoscaler:
      enabled: true
      updateMode: Initial

    # Per-workload PDB (overrides root)
    podDisruptionBudget:
      enabled: true
      minAvailable: 1

    # NetworkPolicy with ingress + egress rules
    networkPolicy:
      enabled: true
      policyTypes:
        - Ingress
        - Egress
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: ingress-nginx
          ports:
            - port: 8080
              protocol: TCP
      egress:
        - to:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: db
          ports:
            - port: 5432
              protocol: TCP
        - ports:                         # allow DNS
            - port: 53
              protocol: UDP

    # Per-workload httpRoute rules merged into the root httpRoute above
    httpRoute:
      enabled: true
      priority: 10
      rules:
        - matches:
            - path:
                type: PathPrefix
                value: /api
          backendRefs:
            - port: 80

    # Init container (runs before main container; no probes/lifecycle)
    initContainers:
      wait-for-db:
        image:
          repository: busybox
          tag: "1.36"
        command: |
          until nc -z db.default.svc.cluster.local 5432; do
            echo "waiting for db..."; sleep 2
          done

    # Sidecar container
    sidecars:
      otel-collector:
        image:
          repository: otel/opentelemetry-collector-contrib
          tag: "0.103.0"
        args:
          - "--config=/etc/otel/config.yaml"
        ports:
          otlp:
            containerPort: 4318
            protocol: TCP
        resources:
          requests:
            cpu: 50m
            memory: 64Mi
          limits:
            memory: 128Mi

    # Per-workload volume (merged with root volumes)
    volumes:
      api-tmp:
        emptyDir: {}

    volumeMounts:
      api-tmp:
        mountPath: /app/tmp

    # Override root topologySpreadConstraints for this workload
    topologySpreadConstraints:
      - maxSkew: 1
        topologyKey: kubernetes.io/hostname
        whenUnsatisfiable: DoNotSchedule

    strategy:
      type: RollingUpdate
      rollingUpdate:
        maxSurge: 2
        maxUnavailable: 0

    minReadySeconds: 10

  # --- worker: background processor ---
  # Features: KEDA, PodMonitor (type=pod, discovery=crd), inherit overrides,
  #           workload-level tolerations replacing root, resizePolicy,
  #           resourceClaims (DRA)
  worker:
    image:
      repository: ghcr.io/example/worker
      tag: v0.9.0

    inherit:
      env:
        global: false                   # skip global.env on this workload
      configMapMount:
        app-config: false               # skip the chart-owned configmap here

    tolerations: []                     # opt out of root tolerations

    metrics:
      enabled: true
      type: pod                         # renders PodMonitor instead of ServiceMonitor
      discovery: crd
      path: /metrics
      port: 8080

    # KEDA ScaledObject (mutually exclusive with hpa on the same workload)
    keda:
      enabled: true
      minReplicas: 1
      maxReplicas: 20
      pollingInterval: 30
      cooldownPeriod: 300
      triggers:
        - type: kafka
          metadata:
            bootstrapServers: kafka.kafka.svc.cluster.local:9092
            consumerGroup: myapp-worker
            topic: events
            lagThreshold: "100"

    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        memory: 256Mi
      # DRA: name must match an entry in resourceClaims below
      claims:
        - name: gpu

    # In-place resize: apply new cpu/memory without restarting the container.
    # Memory usually needs RestartContainer since most runtimes can't shrink
    # their heap live; cpu defaults to NotRequired if omitted.
    resizePolicy:
      - resourceName: cpu
        restartPolicy: NotRequired
      - resourceName: memory
        restartPolicy: RestartContainer

    # Dynamic Resource Allocation (DRA) — only meaningful on a cluster with the
    # DRA feature and a matching device driver installed; shown here for shape.
    resourceClaims:
      - name: gpu
        source:
          resourceClaimTemplateName: worker-gpu-template

  # --- frontend: shows annotations-based metrics discovery ---
  # Features: single port, prometheus.io/* annotations (no ServiceMonitor CRD), paused
  frontend:
    image:
      repository: ghcr.io/example/frontend
      tag: v2.1.0

    service:
      enabled: true
      type: ClusterIP
      port: 80
      targetPort: 3000

    metrics:
      enabled: true
      type: service
      discovery: annotations            # injects prometheus.io/* instead of rendering CRD
      port: 3000
      path: /metrics

    podDisruptionBudget:
      enabled: false                    # opt out of root PDB

    paused: false                       # true freezes the rollout (Deployment-only field)

    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        memory: 128Mi

# ---------------------------------------------------------------------------
# StatefulSets
# ---------------------------------------------------------------------------

statefulSets:

  # --- web: nginx serving from a per-replica PVC ---
  # Features: volumeClaimTemplates (list), independent client Service alongside
  #           a minimal governing headlessService, persistentVolumeClaimRetentionPolicy,
  #           ordinals, podManagementPolicy, NetworkPolicy
  #
  # This deliberately is NOT the "replicated database" shape (that needs
  # peer-to-peer pod DNS, so headlessService itself carries ports/
  # publishNotReadyAddresses and there's usually no separate client Service).
  # Here the StatefulSet exists purely for stable per-replica storage — nginx
  # replicas are interchangeable and don't need to find each other by name, so
  # the client-facing Service is what actually matters and headlessService is
  # left at its default (only there because spec.serviceName requires it).
  web:
    image:
      repository: nginx
      tag: "1.27"

    replicaCount: 3
    podManagementPolicy: Parallel

    # Deletes PVCs left over from scale-down/deletion instead of retaining them forever
    persistentVolumeClaimRetentionPolicy:
      whenDeleted: Retain
      whenScaled: Delete

    ordinals:
      start: 0                          # default; shown for reference

    # Governing headless Service (clusterIP: None) — required for spec.serviceName
    # and stable per-pod DNS. Left empty: only headless-appropriate fields are
    # accepted here (ports, annotations, publishNotReadyAddresses, ipFamilies,
    # ipFamilyPolicy) — type/loadBalancer*/traffic-policy fields have no meaning
    # without a virtual IP, so headlessService doesn't accept them at all.
    headlessService: {}

    # Independent, regular Service for client traffic — always its own object,
    # coexists with headlessService above without ever touching serviceName.
    service:
      enabled: true
      type: ClusterIP
      port: 80
      targetPort: 80

    # Plain nginx has no /metrics endpoint; opt out of the global monitoring
    # default (integrations.monitoring.defaults.enabled: true above) instead
    # of getting a ServiceMonitor that scrapes a port nothing is listening on.
    metrics:
      enabled: false

    # PVC templates — must be a list (Kubernetes native form)
    volumeClaimTemplates:
      - metadata:
          name: html
        spec:
          accessModes:
            - ReadWriteOnce
          storageClassName: standard
          resources:
            requests:
              storage: 5Gi

    # Per-pod volumeMount referencing the PVC template named "html"
    volumeMounts:
      html:
        mountPath: /usr/share/nginx/html

    networkPolicy:
      enabled: true
      policyTypes:
        - Ingress
      ingress:
        - from:
            - podSelector:
                matchLabels:
                  app.kubernetes.io/name: api
          ports:
            - port: 80
              protocol: TCP

    resources:
      requests:
        cpu: 100m
        memory: 128Mi
      limits:
        memory: 256Mi

    # Disable auto-mount of chart-owned configmap (this workload doesn't need app config)
    inherit:
      configMapMount: false

  # --- cache: minimal peer-to-peer StatefulSet ---
  # Features: the "replicated database" shape mentioned above — headlessService
  # carries its own port and is used directly for pod-to-pod discovery, so
  # there's no separate client Service. Also keeps a second statefulSets entry
  # in this file so the chart's own smoke render always exercises the
  # multi-document StatefulSet loop, not just a single one.
  cache:
    image:
      repository: redis
      tag: "7.4"

    replicaCount: 2

    headlessService:
      ports:
        redis:
          port: 6379

    metrics:
      enabled: false

    resources:
      requests:
        cpu: 50m
        memory: 64Mi
      limits:
        memory: 128Mi

    inherit:
      configMapMount: false

# ---------------------------------------------------------------------------
# jobGroups
# ---------------------------------------------------------------------------

jobGroups:

  # --- migrations: sequential DB migration tasks (ArgoCD PreSync hook) ---
  # Features: Job kind, tasks mode (initContainers), ArgoCD hook, hashSuffix: false
  migrations:
    kind: Job
    image:
      repository: ghcr.io/example/migrator
      tag: v1.0.0
    hashSuffix: false                   # required when deletePolicy: HookSucceeded
    envSecrets:
      - app-secrets
    hooks:
      argocd:
        hook: PreSync
        syncWave: "-5"
        deletePolicy: HookSucceeded
    jobs:
      schema:
        backoffLimit: 1
        ttlSecondsAfterFinished: 3600
        activeDeadlineSeconds: 600
        tasks:
          01-create-tables:
            command: |
              psql -c "CREATE TABLE IF NOT EXISTS events (id SERIAL PRIMARY KEY);"
          02-seed-data:
            args:
              - seed
              - --env=production

  # --- cleanup: nightly CronJob (no hooks — CronJobs don't support hooks) ---
  # Features: CronJob kind, schedule, timeZone, concurrencyPolicy, history limits
  cleanup:
    kind: CronJob
    image:
      repository: ghcr.io/example/cleaner
      tag: v0.3.0
    jobs:
      nightly:
        schedule: "0 2 * * *"
        timeZone: UTC
        concurrencyPolicy: Forbid
        successfulJobsHistoryLimit: 3
        failedJobsHistoryLimit: 1
        startingDeadlineSeconds: 120
        command: ./cleanup.sh
        backoffLimit: 2

  # --- post-deploy: Helm hook after install/upgrade ---
  # Features: Job kind, Helm hook, single-container command mode
  post-deploy:
    kind: Job
    hashSuffix: false
    hooks:
      helm:
        hook: post-install,post-upgrade
        weight: "10"
        deletePolicy: hook-succeeded
    jobs:
      notify:
        command: |
          echo "Deploy complete at $(date)"
        ttlSecondsAfterFinished: 300

  # --- bulk-export: parallel sharded export ---
  # Features: completions/parallelism, completionMode: Indexed (required by
  #           backoffLimitPerIndex/successPolicy), podFailurePolicy,
  #           podReplacementPolicy, suspend
  bulk-export:
    kind: Job
    image:
      repository: ghcr.io/example/exporter
      tag: v1.4.0
    completionMode: Indexed
    completions: 5
    parallelism: 5
    backoffLimitPerIndex: 2            # retries are scoped per index instead of the whole Job
    successPolicy:
      rules:
        - succeededIndexes: "0-4"
          succeededCount: 5
    podFailurePolicy:
      rules:
        - action: FailIndex             # OOM on this index: stop retrying that shard
          onExitCodes:
            containerName: export
            operator: In
            values: [137]
        - action: Ignore                # node drain/preemption: retry, don't count against backoff
          onPodConditions:
            - type: DisruptionTarget
              status: "True"
    podReplacementPolicy: Failed
    suspend: false                      # true pauses pod creation without renaming the Job
    jobs:
      export:
        command: |
          export-shard --index=$JOB_COMPLETION_INDEX --total=5
