{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "imageShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": ["string", "integer", "number"]},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "strategyShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["RollingUpdate", "Recreate"]},
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSurge": {"type": ["integer", "string"]},
            "maxUnavailable": {"type": ["integer", "string"]}
          }
        }
      }
    },
    "statefulSetUpdateStrategyShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["RollingUpdate", "OnDelete"]},
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "partition": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "inheritShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global": {"type": "boolean"},
            "root": {"type": "boolean"}
          }
        },
        "configMaps": {"type": "boolean"},
        "configMapMount": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "object", "additionalProperties": {"type": "boolean"}}
          ]
        }
      }
    },
    "inheritRootSchedParamsShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "affinity": {"type": "boolean"},
        "tolerations": {"type": "boolean"},
        "tsc": {"type": "boolean"}
      }
    },
    "headlessServiceShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"}
      }
    },
    "servicePortEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": ["integer", "string"]},
        "protocol": {"type": "string", "enum": ["TCP", "UDP", "SCTP"]}
      }
    },
    "serviceShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": ["integer", "string"]},
        "ports": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/servicePortEntry"}
        },
        "annotations": {"type": "object"},
        "clusterIP": {"type": "string"},
        "loadBalancerIP": {"type": "string"},
        "externalTrafficPolicy": {"type": "string", "enum": ["Cluster", "Local"]},
        "sessionAffinity": {"type": "string", "enum": ["None", "ClientIP"]},
        "publishNotReadyAddresses": {"type": "boolean"}
      }
    },
    "metricsExposeServiceShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "metricsShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": "string", "enum": ["prometheus", "victoriametrics"]},
        "discovery": {"type": "string", "enum": ["crd", "annotations"]},
        "type": {"type": "string", "enum": ["service", "pod"]},
        "port": {"type": ["string", "integer"]},
        "targetPort": {"type": ["string", "integer"]},
        "path": {"type": "string"},
        "scheme": {"type": "string", "enum": ["http", "https"]},
        "interval": {"type": "string"},
        "scrapeTimeout": {"type": "string"},
        "relabelConfigs": {"type": "array"},
        "basicAuth": {"type": "object"},
        "headers": {"type": "array"},
