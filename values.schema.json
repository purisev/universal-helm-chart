        "maxReplicas": {"type": "integer", "minimum": 1},
        "metrics": {"type": "array"},
        "behavior": {"type": "object"}
      }
    },
    "pdbShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]},
        "maxUnavailable": {"type": ["integer", "string"]}
      }
    },
    "vpaShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "updateMode": {"type": "string", "enum": ["Off", "Initial", "Recreate", "InPlaceOrRecreate"]},
        "resourcePolicy": {"type": "object"}
      }
    },
    "networkPolicyShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingress": {"type": "array"},
        "egress": {"type": "array"},
        "policyTypes": {
          "type": "array",
          "items": {"type": "string", "enum": ["Ingress", "Egress"]}
        }
      }
    },
    "tscShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "constraints": {"type": "array"}
      }
    },
    "routeEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "priority": {"type": "integer"},
        "annotations": {"type": "object"},
        "metadataAnnotations": {"type": "object"},
        "parentRefs": {"type": "array"},
        "hostnames": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rules": {"type": "array"}
      }
    },
    "ingressShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressClassName": {"type": "string"},
