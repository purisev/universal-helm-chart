{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "revisionHistoryLimit": {
      "type": "integer",
      "minimum": 0
    },
    "progressDeadlineSeconds": {
      "type": "integer",
      "minimum": 1
    },
    "minReadySeconds": {
      "type": "integer",
      "minimum": 0
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "automountServiceAccountToken": {
      "type": "boolean"
    },
    "podSecurityContext": {
      "type": "object"
    },
    "securityContext": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object"
    },
    "jobPodAnnotations": {
      "type": "object"
    },
    "jobCompletionImage": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "priorityClassName": {
      "type": "string"
    },
    "nodeSelector": {
      "type": "object"
    },
    "tolerations": {
      "type": "array"
    },
    "affinity": {
      "type": "object"
    },
    "hostAliases": {
      "type": "array"
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "volumes": {
      "type": "array"
    },
    "volumeMounts": {
      "type": "object"
    },
    "envSecrets": {
      "type": "array"
    },
    "envConfigMaps": {
      "type": "array"
    },
    "deployments": {
      "type": "object"
    },
    "statefulSets": {
      "type": "object"
    },
    "configMaps": {
      "type": "object"
    },
    "secretStores": {
      "type": "object"
    },
    "externalSecrets": {
      "type": "object"
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "create": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "rbac": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rules": {
          "type": "array"
        }
      }
    },
    "reloader": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "env": {
      "type": "object"
    },
    "strategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "Recreate"
          ]
        },
        "rollingUpdate": {
          "type": "object",
          "properties": {
            "maxSurge": {
              "type": [
                "integer",
                "string"
              ]
            },
            "maxUnavailable": {
              "type": [
                "integer",
                "string"
              ]
            }
          }
        }
      }
    },
    "statefulSetUpdateStrategy": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "RollingUpdate",
            "OnDelete"
          ]
        },
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "partition": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "ingress": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressClassName": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "hosts": {
          "type": "array"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "ingresses": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "ingressClassName": {
            "type": "string"
          },
          "annotations": {
            "type": "object"
          },
          "hosts": {
            "type": "array"
          },
          "tls": {
            "type": "array"
          }
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        },
        "maxUnavailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "verticalPodAutoscaler": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "updateMode": {
          "type": "string",
          "enum": [
            "Off",
            "Initial",
            "Recreate",
            "InPlaceOrRecreate"
          ]
        },
        "resourcePolicy": {
          "type": "object"
        }
      }
    },
    "jobGroups": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enabled": { "type": "boolean" },
          "kind": { "type": "string", "enum": ["Job", "CronJob"] },
          "hooks": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "argocd": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "hook": { "type": "string", "enum": ["", "PreSync", "Sync", "PostSync", "SyncFail"] },
                  "syncWave": { "type": ["string", "integer"] },
                  "deletePolicy": { "type": "string", "enum": ["", "HookSucceeded", "HookFailed", "BeforeHookCreation"] }
                }
              },
              "helm": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "hook": { "type": "string" },
                  "weight": { "type": ["string", "integer"] },
                  "deletePolicy": { "type": "string", "enum": ["", "before-hook-creation", "hook-succeeded", "hook-failed"] }
                }
              }
            }
          },
          "image": { "type": "object" },
          "env": { "type": "object" },
          "envSecrets": { "type": "array" },
          "envConfigMaps": { "type": "array" },
          "inherit": { "type": "object" },
          "backoffLimit": { "type": "integer", "minimum": 0 },
          "ttlSecondsAfterFinished": { "type": ["integer", "null"], "minimum": 0 },
          "activeDeadlineSeconds": { "type": ["integer", "null"], "minimum": 1 },
          "restartPolicy": { "type": "string", "enum": ["Never", "OnFailure"] },
          "podSecurityContext": { "type": "object" },
          "securityContext": { "type": "object" },
          "resources": { "type": "object" },
          "serviceAccountName": { "type": "string" },
          "automountServiceAccountToken": { "type": ["boolean", "null"] },
          "terminationGracePeriodSeconds": { "type": ["integer", "null"], "minimum": 0 },
          "volumes": { "type": "array" },
          "volumeMounts": { "type": "array" },
          "useRootVolumes": { "type": "boolean" },
          "useRootVolumeMounts": { "type": "boolean" },
          "nodeSelector": { "type": "object" },
          "affinity": { "type": "object" },
          "tolerations": { "type": "array" },
          "metadataAnnotations": { "type": "object" },
          "podAnnotations": { "type": "object" },
          "hashSuffix": { "type": "boolean" },
          "hashIncludePodAnnotations": { "type": "boolean" },
          "jobs": {
            "type": "object",
            "additionalProperties": { "type": "object" }
          }
        },
        "required": ["jobs"]
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "provider": {
              "type": "string",
              "enum": ["prometheus", "victoriametrics"]
            },
            "discovery": {
              "type": "string",
              "enum": ["crd", "annotations"]
            },
            "enabled": { "type": "boolean" },
            "type": {
              "type": "string",
              "enum": ["service", "pod"]
            },
            "port": { "type": "string" },
            "path": { "type": "string" },
            "scheme": {
              "type": "string",
              "enum": ["http", "https"]
            },
            "interval": { "type": "string" },
            "scrapeTimeout": { "type": "string" },
            "relabelConfigs": { "type": "array" },
            "basicAuth": { "type": "object" },
            "headers": { "type": "array" },
            "exposeService": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": { "type": "boolean" },
                "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
                "targetPort": { "type": "integer", "minimum": 1, "maximum": 65535 }
              }
            }
          }
        }
      }
    },
    "syncWaves": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "deploymentSyncWave": {
          "type": [
            "string",
            "integer"
          ]
        }
      }
    },
    "topologySpreadConstraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "constraints": {
          "type": "array"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rules": {
          "type": "array"
        }
      }
    },
    "httpRoutes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "annotations": {
            "type": "object"
          },
          "parentRefs": {
            "type": "array"
          },
          "hostnames": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "rules": {
            "type": "array"
          }
        }
      }
    },
    "grpcRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array" },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": { "type": "array" }
      }
    },
    "grpcRoutes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "annotations": { "type": "object" },
          "parentRefs": { "type": "array" },
          "hostnames": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rules": { "type": "array" }
        }
      }
    },
    "tlsRoute": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "annotations": { "type": "object" },
        "parentRefs": { "type": "array" },
        "hostnames": {
          "type": "array",
          "items": { "type": "string" }
        },
        "rules": { "type": "array" }
      }
    },
    "tlsRoutes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": { "type": "boolean" },
          "annotations": { "type": "object" },
          "parentRefs": { "type": "array" },
          "hostnames": {
            "type": "array",
            "items": { "type": "string" }
          },
          "rules": { "type": "array" }
        }
      }
    },
    "referenceGrant": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "annotations": {
          "type": "object"
        },
        "from": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": { "type": "string" },
              "kind": { "type": "string" },
              "namespace": { "type": "string" }
            }
          }
        },
        "to": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "group": { "type": "string" },
              "kind": { "type": "string" },
              "name": { "type": "string" }
            }
          }
        }
      }
    },
    "referenceGrants": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "enabled": {
            "type": "boolean"
          },
          "annotations": {
            "type": "object"
          },
          "from": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "group": { "type": "string" },
                "kind": { "type": "string" },
                "namespace": { "type": "string" }
              }
            }
          },
          "to": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "group": { "type": "string" },
                "kind": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "imageUpdater": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "appNamePattern": {
          "type": "string"
        },
        "commonUpdateSettings": {
          "type": "object"
        },
        "writeBackConfig": {
          "type": "object"
        },
        "images": {
          "type": "array"
        },
        "applicationRefs": {
          "type": "array"
        }
      }
    }
  }
}
