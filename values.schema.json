            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {"type": "string"},
              "kind": {"type": "string"},
              "namespace": {"type": "string"}
            }
          }
        },
        "to": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {"type": "string"},
              "kind": {"type": "string"},
              "name": {"type": "string"}
            }
          }
        }
      }
