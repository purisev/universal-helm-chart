{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "$defs": {
    "imageShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string"},
        "tag": {"type": ["string", "integer", "number"]},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "strategyShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["RollingUpdate", "Recreate"]},
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxSurge": {"type": ["integer", "string"]},
            "maxUnavailable": {"type": ["integer", "string"]}
          }
        }
      }
    },
    "statefulSetUpdateStrategyShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string", "enum": ["RollingUpdate", "OnDelete"]},
        "rollingUpdate": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "partition": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "persistentVolumeClaimRetentionPolicyShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "whenDeleted": {"type": "string", "enum": ["Retain", "Delete"]},
        "whenScaled": {"type": "string", "enum": ["Retain", "Delete"]}
      }
    },
    "statefulSetOrdinalsShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "start": {"type": "integer", "minimum": 0}
      }
    },
    "podResourceClaimEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "source": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "resourceClaimName": {"type": "string"},
            "resourceClaimTemplateName": {"type": "string"}
          }
        }
      }
    },
    "inheritShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "env": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "global": {"type": "boolean"},
            "root": {"type": "boolean"}
          }
        },
        "configMaps": {"type": "boolean"},
        "envSecrets": {"type": "boolean"},
        "configMapMount": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "object", "additionalProperties": {"type": "boolean"}}
          ]
        }
      }
    },
    "headlessServiceShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": ["integer", "string"]},
        "ports": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/servicePortEntry"}
        },
        "annotations": {"type": "object"},
        "publishNotReadyAddresses": {"type": "boolean"},
        "ipFamilies": {
          "type": "array",
          "maxItems": 2,
          "items": {"type": "string", "enum": ["IPv4", "IPv6"]}
        },
        "ipFamilyPolicy": {"type": "string", "enum": ["SingleStack", "PreferDualStack", "RequireDualStack"]}
      }
    },
    "servicePortEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": ["integer", "string"]},
        "protocol": {"type": "string", "enum": ["TCP", "UDP", "SCTP"]}
      }
    },
    "sessionAffinityConfigShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clientIP": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
          }
        }
      }
    },
    "serviceShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer", "ExternalName"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": ["integer", "string"]},
        "ports": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/servicePortEntry"}
        },
        "annotations": {"type": "object"},
        "clusterIP": {"type": "string"},
        "clusterIPs": {"type": "array", "maxItems": 2, "items": {"type": "string"}},
        "externalName": {"type": "string"},
        "externalIPs": {"type": "array", "items": {"type": "string"}},
        "loadBalancerIP": {"type": "string"},
        "loadBalancerClass": {"type": "string"},
        "loadBalancerSourceRanges": {"type": "array", "items": {"type": "string"}},
        "allocateLoadBalancerNodePorts": {"type": "boolean"},
        "healthCheckNodePort": {"type": "integer", "minimum": 1, "maximum": 65535},
        "externalTrafficPolicy": {"type": "string", "enum": ["Cluster", "Local"]},
        "internalTrafficPolicy": {"type": "string", "enum": ["Cluster", "Local"]},
        "sessionAffinity": {"type": "string", "enum": ["None", "ClientIP"]},
        "sessionAffinityConfig": {"$ref": "#/$defs/sessionAffinityConfigShape"},
        "ipFamilies": {
          "type": "array",
          "maxItems": 2,
          "items": {"type": "string", "enum": ["IPv4", "IPv6"]}
        },
        "ipFamilyPolicy": {"type": "string", "enum": ["SingleStack", "PreferDualStack", "RequireDualStack"]},
        "trafficDistribution": {"type": "string"},
        "publishNotReadyAddresses": {"type": "boolean"}
      }
    },
    "metricsExposeServiceShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "targetPort": {"type": "integer", "minimum": 1, "maximum": 65535}
      }
    },
    "metricsShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "provider": {"type": "string", "enum": ["prometheus", "victoriametrics"]},
        "discovery": {"type": "string", "enum": ["crd", "annotations"]},
        "type": {"type": "string", "enum": ["service", "pod"]},
        "port": {"type": ["string", "integer"]},
        "targetPort": {"type": ["string", "integer"]},
        "path": {"type": "string"},
        "scheme": {"type": "string", "enum": ["http", "https"]},
        "interval": {"type": "string"},
        "scrapeTimeout": {"type": "string"},
        "relabelConfigs": {"type": "array"},
        "basicAuth": {"type": "object"},
        "headers": {"type": "array"},
        "exposeService": {"$ref": "#/$defs/metricsExposeServiceShape"}
      }
    },
    "kedaShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 0},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "pollingInterval": {"type": "integer", "minimum": 1},
        "cooldownPeriod": {"type": "integer", "minimum": 0},
        "idleReplicaCount": {"type": "integer", "minimum": 0},
        "triggers": {"type": "array"}
      }
    },
    "hpaShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minReplicas": {"type": "integer", "minimum": 1},
        "maxReplicas": {"type": "integer", "minimum": 1},
        "metrics": {"type": "array"},
        "behavior": {"type": "object"}
      }
    },
    "pdbShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "minAvailable": {"type": ["integer", "string"]},
        "maxUnavailable": {"type": ["integer", "string"]},
        "unhealthyPodEvictionPolicy": {"type": "string", "enum": ["IfHealthyBudget", "AlwaysAllow"]}
      }
    },
    "vpaShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "updateMode": {"type": "string", "enum": ["Off", "Initial", "Recreate", "InPlaceOrRecreate"]},
        "resourcePolicy": {"type": "object"}
      }
    },
    "networkPolicyShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingress": {"type": "array"},
        "egress": {"type": "array"},
        "policyTypes": {
          "type": "array",
          "items": {"type": "string", "enum": ["Ingress", "Egress"]}
        }
      }
    },
    "grpcRouteRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "minLength": 1,
          "maxLength": 253
        },
        "matches": {"type": "array"},
        "filters": {"type": "array"},
        "backendRefs": {"type": "array"},
        "serviceName": {"type": "string"},
        "servicePort": {"type": ["integer", "string"]},
        "sessionPersistence": {"$ref": "#/$defs/httpRouteSessionPersistence"}
      }
    },
    "grpcRouteEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {"type": "object"},
        "parentRefs": {"type": "array"},
        "hostnames": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/grpcRouteRule"}
        }
      }
    },
    "grpcWorkloadRouteEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0},
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/grpcRouteRule"}
        }
      }
    },
    "tlsRouteRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "minLength": 1,
          "maxLength": 253
        },
        "backendRefs": {"type": "array"},
        "serviceName": {"type": "string"},
        "servicePort": {"type": ["integer", "string"]}
      }
    },
    "tlsRouteEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {"type": "object"},
        "parentRefs": {"type": "array"},
        "hostnames": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/tlsRouteRule"}
        }
      }
    },
    "tlsWorkloadRouteEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0},
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/tlsRouteRule"}
        }
      }
    },
    "gatewayApiDuration": {
      "type": "string",
      "pattern": "^([0-9]{1,5}(h|m|s|ms)){1,4}$"
    },
    "httpRouteTimeouts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "request": {"$ref": "#/$defs/gatewayApiDuration"},
        "backendRequest": {"$ref": "#/$defs/gatewayApiDuration"}
      }
    },
    "httpRouteRetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attempts": {"type": "integer", "minimum": 0},
        "codes": {
          "type": "array",
          "items": {"type": "integer", "minimum": 400, "maximum": 599},
          "minItems": 1
        },
        "backoff": {"$ref": "#/$defs/gatewayApiDuration"}
      }
    },
    "httpRouteSessionPersistence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sessionName": {"type": "string", "minLength": 1, "maxLength": 128},
        "absoluteTimeout": {"$ref": "#/$defs/gatewayApiDuration"},
        "idleTimeout": {"$ref": "#/$defs/gatewayApiDuration"},
        "type": {"enum": ["Cookie", "Header"]},
        "cookieConfig": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lifetimeType": {"enum": ["Permanent", "Session"]}
          }
        }
      }
    },
    "httpRouteRule": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "minLength": 1,
          "maxLength": 253
        },
        "matches": {"type": "array"},
        "filters": {"type": "array"},
        "backendRefs": {"type": "array"},
        "serviceName": {"type": "string"},
        "servicePort": {"type": ["integer", "string"]},
        "timeouts": {"$ref": "#/$defs/httpRouteTimeouts"},
        "retry": {"$ref": "#/$defs/httpRouteRetry"},
        "sessionPersistence": {"$ref": "#/$defs/httpRouteSessionPersistence"}
      }
    },
    "httpRouteEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {"type": "object"},
        "parentRefs": {"type": "array"},
        "hostnames": {
          "type": "array",
          "items": {"type": "string"}
        },
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/httpRouteRule"}
        }
      }
    },
    "httpWorkloadRouteEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "priority": {"type": "integer", "minimum": 0},
        "rules": {
          "type": "array",
          "items": {"$ref": "#/$defs/httpRouteRule"}
        }
      }
    },
    "esoSecretStoreEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "kind": {"type": "string", "enum": ["SecretStore", "ClusterSecretStore"]},
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "vault": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "server": {"type": "string"},
                "path": {"type": "string"},
                "version": {"type": "string", "enum": ["v1", "v2"]},
                "namespace": {"type": "string"},
                "auth": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "jwt": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "mountPath": {"type": "string"},
                        "role": {"type": "string"},
                        "serviceAccountRef": {"type": "string"},
                        "audiences": {"type": "array", "items": {"type": "string"}},
                        "expirationSeconds": {"type": "integer", "minimum": 1}
                      }
                    }
                  }
                }
              }
            },
            "aws": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "service": {"type": "string", "enum": ["SecretsManager", "ParameterStore"]},
                "region": {"type": "string"},
                "auth": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "jwt": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "serviceAccountRef": {"type": "string"},
                        "audiences": {"type": "array", "items": {"type": "string"}}
                      }
                    }
                  }
                }
              }
            },
            "gcpsm": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "projectID": {"type": "string"},
                "auth": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "workloadIdentity": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "clusterLocation": {"type": "string"},
                        "clusterName": {"type": "string"},
                        "clusterProjectID": {"type": "string"},
                        "serviceAccountRef": {"type": "string"}
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "esoExternalSecretRemoteRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "remoteKey": {"type": "string"},
        "property": {"type": "string"},
        "conversionStrategy": {"type": "string", "enum": ["Default", "Unicode"]},
        "decodingStrategy": {"type": "string", "enum": ["None", "Auto", "Base64", "Base64URL"]},
        "metadataPolicy": {"type": "string", "enum": ["None", "Fetch"]}
      }
    },
    "esoExternalSecretEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "secretStore": {"type": "string"},
        "storeKind": {"type": "string", "enum": ["SecretStore", "ClusterSecretStore"]},
        "refreshInterval": {"type": "string"},
        "targetName": {"type": "string"},
        "type": {"type": "string"},
        "data": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/esoExternalSecretRemoteRef"}
        },
        "dataFrom": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "remoteKey": {"type": "string"},
              "conversionStrategy": {"type": "string", "enum": ["Default", "Unicode"]},
              "decodingStrategy": {"type": "string", "enum": ["None", "Auto", "Base64", "Base64URL"]},
              "metadataPolicy": {"type": "string", "enum": ["None", "Fetch"]}
            }
          }
        }
      }
    },
    "ingressShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "ingressClassName": {"type": "string"},
        "annotations": {"type": "object"},
        "hosts": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "tls": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "hosts": {"type": "array", "items": {"type": "string"}},
              "secretName": {"type": "string"}
            }
          }
        },
        "defaultBackend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceName": {"type": "string"},
            "servicePort": {"type": "integer", "minimum": 1, "maximum": 65535}
          }
        }
      }
    },
    "referenceGrantShape": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "annotations": {"type": "object"},
        "from": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {"type": "string"},
              "kind": {"type": "string"},
              "namespace": {"type": "string"}
            }
          }
        },
        "to": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "group": {"type": "string"},
              "kind": {"type": "string"},
              "name": {"type": "string"}
            }
          }
        }
      }
    },
    "containerEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "image": {"$ref": "#/$defs/imageShape"},
        "command": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "args": {
          "type": "array",
          "items": {"type": ["string", "integer", "number"]}
        },
        "env": {"type": "object"},
        "envSecrets": {"type": "array", "items": {"type": "string"}},
        "envConfigMaps": {"type": "array", "items": {"type": "string"}},
        "inherit": {"$ref": "#/$defs/inheritShape"},
        "ports": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "useRootVolumeMounts": {"type": "boolean"},
        "hostAliases": {"type": "array"},
        "securityContext": {"type": "object"},
        "resources": {"type": "object"},
        "volumeMounts": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "lifecycle": {"type": "object"},
        "probesEnabled": {"type": "boolean"},
        "resizePolicy": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "resourceName": {"type": "string", "enum": ["cpu", "memory"]},
              "restartPolicy": {"type": "string", "enum": ["NotRequired", "RestartContainer"]}
            }
          }
        },
        "livenessProbe": {"type": "object"},
        "readinessProbe": {"type": "object"},
        "startupProbe": {"type": "object"},
        "metrics": {"$ref": "#/$defs/metricsShape"}
      }
    },
    "deploymentEntry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "replicaCount": {"type": "integer", "minimum": 0},
        "image": {"$ref": "#/$defs/imageShape"},
        "command": {
          "oneOf": [
            {"type": "string"},
            {"type": "array", "items": {"type": "string"}}
          ]
        },
        "args": {
          "type": "array",
          "items": {"type": ["string", "integer", "number"]}
        },
        "env": {"type": "object"},
        "envSecrets": {"type": "array", "items": {"type": "string"}},
        "envConfigMaps": {"type": "array", "items": {"type": "string"}},
        "inherit": {"$ref": "#/$defs/inheritShape"},
        "inheritRootHostAliases": {"type": "boolean"},
        "service": {"$ref": "#/$defs/serviceShape"},
        "ports": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "sidecars": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/containerEntry"}
        },
        "initContainers": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/containerEntry"}
        },
        "httpRoute": {"$ref": "#/$defs/httpWorkloadRouteEntry"},
        "grpcRoute": {"$ref": "#/$defs/grpcWorkloadRouteEntry"},
        "tlsRoute": {"$ref": "#/$defs/tlsWorkloadRouteEntry"},
        "strategy": {"$ref": "#/$defs/strategyShape"},
        "progressDeadlineSeconds": {"type": "integer", "minimum": 1},
        "minReadySeconds": {"type": "integer", "minimum": 0},
        "terminationGracePeriodSeconds": {"type": "integer", "minimum": 0},
        "paused": {"type": "boolean"},
        "automountServiceAccountToken": {"type": "boolean"},
        "serviceAccountName": {"type": "string"},
        "priorityClassName": {"type": "string"},
        "useRootVolumes": {"type": "boolean"},
        "useRootVolumeMounts": {"type": "boolean"},
        "volumes": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "volumeMounts": {
          "type": "object",
          "additionalProperties": {"type": "object"}
        },
        "securityContext": {"type": "object"},
        "podSecurityContext": {"type": "object"},
        "resources": {"type": "object"},
        "podAnnotations": {"type": "object"},
        "metadataAnnotations": {"type": "object"},
        "nodeSelector": {"type": "object"},
        "affinity": {"type": "object"},
        "tolerations": {"type": "array"},
        "topologySpreadConstraints": {"type": "array", "items": {"type": "object"}},
        "hostAliases": {"type": "array"},
        "resourceClaims": {
          "type": "array",
          "items": {"$ref": "#/$defs/podResourceClaimEntry"}
        },
        "lifecycle": {"type": "object"},
